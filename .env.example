# Supabase project URL (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only key with insert rights. Use the service_role key or a new
# "secret" key (sb_secret_...). NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Resend (resend.com). Sends an email on each quote-request submission.
# Leave any of these unset to skip emailing (DB insert still happens).
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=quotes@yourdomain.com
EMAIL_TO=you@yourdomain.com
